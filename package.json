{
  "name": "kaviya-birthday",
  "version": "1.0.0",
  "private": true,
  "description": "A birthday cake-cutting experience for Kaviya",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=dist/birthday.js",
    "watch": "esbuild src/main.js --bundle --format=iife --target=es2020 --outfile=dist/birthday.js --watch",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.180.0"
  }
}
